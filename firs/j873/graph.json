{
    "node.description": "Mac mini speaker",
    "media.name": "Mac mini Speaker",
    "filter.graph": {
        "nodes": [
            {
                "type": "builtin",
                "label": "mixer",
                "name": "mono",
                "control": {
                    "Gain 1": 0.5,
                    "Gain 2": 0.5
                }
            },
            {
                "type": "builtin",
                "label": "bq_highpass",
                "name": "hpf_1",
                "control": {
                    "Freq": 100.0,
                    "Q": 0.5412
                }
            },
            {
                "type": "builtin",
                "label": "bq_highpass",
                "name": "hpf_2",
                "control": {
                    "Freq": 100.0,
                    "Q": 1.3066
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/limiter_mono",
                "name": "speaker_peak",
                "control": {
                    "th": 0.891,
                    "lk": 5.0,
                    "at": 1.0,
                    "rt": 20.0,
                    "ovs": 22,
                    "alr": 0,
                    "boost": 0
                }
            }
        ],
        "links": [
            {"output": "mono:Out", "input": "hpf_1:In"},
            {"output": "hpf_1:Out", "input": "hpf_2:In"},
            {"output": "hpf_2:Out", "input": "speaker_peak:in"}
        ],
        "inputs": [
            "mono:In 1",
            "mono:In 2"
        ],
        "outputs": [
            "speaker_peak:out"
        ]
    },
    "capture.props": {
        "node.name": "audio_effect.j873-speaker",
        "media.class": "Audio/Sink",
        "audio.channels": "2",
        "audio.position": ["FL", "FR"],
        "audio.allowed-rates": [48000],
        "node.virtual": "false",
        "priority.session": 850,
        "state.default-volume": 0.343,
        "device.icon-name": "audio-speakers"
    },
    "playback.props": {
        "node.name": "effect_output.j873-speaker",
        "node.description": "Mac mini Speaker DSP Out",
        "media.name": "Mac mini Speaker DSP Out",
        "target.object": "alsa_output.platform-sound.RawSpeakers",
        "node.dont-fallback": "true",
        "node.passive": "true",
        "audio.channels": "1",
        "audio.allowed-rates": [48000],
        "audio.position": ["MONO"]
    }
}
