{
    "node.description": "MacBook Neo J700 Speakers",
    "media.name": "MacBook Neo J700 Speakers",
    "filter.graph": {
        "nodes": [
            {
                "type": "lv2",
                "plugin": "https://chadmed.au/bankstown",
                "name": "bassex",
                "control": {
                    "bypass": 0,
                    "amt": 1.10,
                    "sat_second": 1.3,
                    "sat_third": 1.75,
                    "blend": 1.0,
                    "ceil": 300.0,
                    "floor": 20.0,
                    "final_hp": 300.0,
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/loud_comp_mono",
                "name": "ell",
                "control": {
                    "enabled": 1,
                    "input": 1.0,
                    "fft": 2
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/loud_comp_mono",
                "name": "elr",
                "control": {
                    "enabled": 1,
                    "input": 1.0,
                    "fft": 2
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convL",
                "config": {
                    "filename": [
                        "/usr/share/asahi-audio/j700/48.wav"
                    ],
                    "channel": 0,
                    "gain": 1.41
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convR",
                "config": {
                    "filename": [
                        "/usr/share/asahi-audio/j700/48.wav"
                    ],
                    "channel": 0,
                    "gain": 1.41
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/mb_compressor_stereo",
                "name": "woofer_bp",
                "control": {
                    "mode": 0,
                    "ce_0": 1,
                    "sla_0": 5.0,
                    "cr_0": 1.75,
                    "al_0": 0.725,
                    "at_0": 1.0,
                    "rt_0": 100,
                    "kn_0": 0.125,
                    "cbe_1": 1,
                    "sf_1": 300.0,
                    "ce_1": 0,
                    "cbe_2": 0,
                    "ce_2": 0,
                    "cbe_3": 0,
                    "ce_3": 0,
                    "cbe_4": 0,
                    "ce_4": 0,
                    "cbe_5": 0,
                    "ce_5": 0,
                    "cbe_6": 0,
                    "ce_6": 0
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/limiter_stereo",
                "name": "final_lim",
                "control": {
                    "th": 0.944,
                    "lk": 5.0,
                    "at": 1.0,
                    "rt": 20.0,
                    "alr": 0,
                    "boost": 0
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/compressor_stereo",
                "name": "woofer_lim",
                "control": {
                    "sla": 5.0,
                    "al": 1.0,
                    "at": 1.0,
                    "rt": 100.0,
                    "cr": 15.0,
                    "kn": 0.5
                }
            },
            {
                "type": "ladspa",
                "plugin": "speakerguard-xlim",
                "label": "speakerguard_xlim",
                "name": "xlim",
                "control": {
                    "Vfs L (V)": 7.30,
                    "Vfs R (V)": 7.33,
                    "Re (ohm)": 4.3,
                    "Bl (T m)": 0.74,
                    "Mms (g)": 0.16,
                    "Kms (N/m)": 1720.0,
                    "Rms (kg/s)": 0.14,
                    "Xmax (mm)": 0.565,
                    "Vmax (m/s)": 0.0,
                    "Peak (FS)": 1.0,
                    "Margin": 0.89,
                    "Release (ms)": 200.0,
                    "Window (ms)": 3.3333,
                    "Hold (ms)": 4.0
                }
            }
        ],
        "links": [
            {"output": "bassex:out_l", "input": "ell:in"},
            {"output": "bassex:out_r", "input": "elr:in"},
            {"output": "ell:out", "input": "convL:In"},
            {"output": "elr:out", "input": "convR:In"},
            {"output": "convL:Out", "input": "woofer_bp:in_l"},
            {"output": "convR:Out", "input": "woofer_bp:in_r"},
            {"output": "woofer_bp:out_l", "input": "woofer_lim:in_l"},
            {"output": "woofer_bp:out_r", "input": "woofer_lim:in_r"},
            {"output": "woofer_lim:out_l", "input": "final_lim:in_l"},
            {"output": "woofer_lim:out_r", "input": "final_lim:in_r"},
            {"output": "final_lim:out_l", "input": "xlim:in_l"},
            {"output": "final_lim:out_r", "input": "xlim:in_r"},
        ],
        "inputs": [
            "bassex:in_l",
            "bassex:in_r"
        ],
        "outputs": [
            "xlim:out_l",
            "xlim:out_r",
        ],
        "capture.volumes": [
            {
                "control": "ell:volume",
                "min": -47.5,
                "max": 0.0,
                "scale": "cubic"
            },
            {
                "control": "elr:volume",
                "min": -47.5,
                "max": 0.0,
                "scale": "cubic"
            }
        ]
    },
    "capture.props": {
        "node.name": "audio_effect.j700-convolver",
        "media.class": "Audio/Sink",
        "audio.channels": "2",
        "audio.position": ["FL", "FR"],
        "audio.allowed-rates": [48000],
        "device.api": "dsp",
        "node.virtual": "false",
        "priority.session": 850,
        "state.default-volume": 0.027,
        "state.restore-props": false,
        "asahi.restore-props": true,
        "device.icon-name": "audio-speakers"
    },
    "playback.props": {
        "node.name": "effect_output.j700-convolver",
        "node.description": "MacBook Neo J700 Speakers DSP Out",
        "media.name": "MacBook Neo J700 Speakers DSP Out",
        "target.object": "alsa_output.platform-sound.RawSpeakers",
        "node.dont-fallback": "true",
        "node.passive": "true",
        "audio.channels": "2",
        "audio.allowed-rates": [48000],
        "audio.position": ["AUX0", "AUX1"]
    }
}
